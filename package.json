{
  "name": "apipilot",
  "version": "1.1.0",
  "private": true,
  "description": "ApiPilot monorepo: backend, frontend, and shared domain packages.",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "backend",
    "frontend",
    "packages/shared-domain"
  ],
  "scripts": {
    "predev": "node scripts/dev-stop.mjs",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "stop": "node scripts/dev-stop.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^9.0.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
