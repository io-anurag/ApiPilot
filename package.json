{
  "name": "apipilot",
  "version": "19.49.3",
  "private": true,
  "description": "ApiPilot monorepo: backend, frontend, and shared domain packages.",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "backend",
    "frontend",
    "packages/shared-domain"
  ],
  "scripts": {
    "predev": "node scripts/check-dependencies.mjs && node scripts/dev-stop.mjs",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "stop": "node scripts/dev-stop.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "prebuild": "node scripts/check-dependencies.mjs",
    "build": "npm run build --workspaces --if-present",
    "pretest": "node scripts/check-dependencies.mjs",
    "test": "vitest run",
    "prelint": "node scripts/check-dependencies.mjs",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "concurrently": "^9.2.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "qs": "6.16.0",
    "sharp": "0.35.5",
    "flatted": "3.4.4",
    "handlebars": "4.7.10",
    "jose": "4.15.9",
    "lodash": "4.18.1",
    "node-forge": "1.4.0",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "underscore": "1.13.8",
    "uuid": "11.1.1",
    "adm-zip": "0.6.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "better-sqlite3@13.0.3": true,
    "onnxruntime-node@1.30.0": true
  }
}
