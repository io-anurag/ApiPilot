{
  "name": "@apipilot/backend",
  "version": "6.4.1",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run --root .",
    "test:ai-real": "cross-env AI_TEST_REAL_MODEL=1 vitest run --root . tests/integration/localProvider.real.test.ts",
    "ai:benchmark": "tsx src/ai/benchmark/runBenchmark.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@apipilot/shared-domain": "*",
    "@huggingface/transformers": "^4.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "js-yaml": "^4.1.0",
    "multer": "^1.4.5-lts.1",
    "newman": "^6.2.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^1.4.12",
    "@types/newman": "^5.3.6",
    "@types/supertest": "^6.0.2",
    "cross-env": "^7.0.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1"
  }
}
