{
  "info": {
    "_postman_id": "apifoundry-fixture",
    "name": "APIFoundry",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "variable": [{ "key": "customer_id", "value": "" }],
  "item": [
    {
      "id": "folder-auth",
      "name": "Auth",
      "item": [
        {
          "id": "req-token",
          "name": "Get token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"ok\", () => pm.response.to.have.status(200));",
                  "pm.environment.set(\"access_token\", pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"{{client_id}}\",\n  \"client_secret\": \"{{client_secret}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/token", "host": ["{{baseUrl}}"], "path": ["auth", "token"] }
          }
        }
      ]
    },
    {
      "id": "folder-customers",
      "name": "Customers",
      "item": [
        {
          "id": "req-list-customers",
          "name": "List customers",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test(\"listed\", () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/customers", "host": ["{{baseUrl}}"], "path": ["api", "v1", "customers"] }
          }
        },
        {
          "id": "req-create-customer",
          "name": "Create customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"customer_id\", body.id);",
                  "pm.test(\"created\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{$randomFullName}}\",\n  \"email\": \"{{$randomEmail}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/customers", "host": ["{{baseUrl}}"], "path": ["api", "v1", "customers"] }
          }
        },
        {
          "id": "req-get-customer",
          "name": "Get customer",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test(\"read\", () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/{{customer_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customers", "{{customer_id}}"]
            }
          }
        },
        {
          "id": "req-update-customer",
          "name": "Update customer",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test(\"updated\", () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated name\"\n}", "options": { "raw": { "language": "json" } } },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/{{customer_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customers", "{{customer_id}}"]
            }
          }
        },
        {
          "id": "req-delete-customer",
          "name": "Delete customer",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test(\"deleted\", () => pm.response.to.have.status(204));"] }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/{{customer_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customers", "{{customer_id}}"]
            }
          }
        }
      ]
    },
    {
      "id": "req-health",
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": { "type": "text/javascript", "exec": ["pm.test(\"healthy\", function () {", "  pm.response.to.have.status(200);", "});"] }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    },
    {
      "id": "req-version",
      "name": "Version",
      "event": [
        {
          "listen": "test",
          "script": { "type": "text/javascript", "exec": ["pm.test(\"version\", () => pm.expect(pm.response.code).to.eql(200));"] }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/version", "host": ["{{baseUrl}}"], "path": ["version"] }
      }
    }
  ]
}
