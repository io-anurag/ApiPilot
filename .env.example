# Backend HTTP server port
BACKEND_PORT=4000

# Frontend Vite dev server port
FRONTEND_DEV_PORT=5173

# AI provider mode: "local" (Transformers.js) or "mock" (deterministic, no real model).
# Defaults to "mock" during automated tests and "local" otherwise if unset.
AI_PROVIDER_MODE=local

# Hugging Face repo id of the local model to load (default: onnx-community/Qwen2.5-0.5B-Instruct)
AI_MODEL_ID=onnx-community/Qwen2.5-0.5B-Instruct

# Local filesystem cache directory for downloaded model files (default: ~/.apipilot/models)
AI_MODEL_CACHE_DIR=

# ONNX weight quantization to load (fp32, fp16, q8, int8, uint8, q4, q4f16, bnb4).
# Left unset, Transformers.js defaults to fp32 on CPU, which is fine for small models but
# an impractically large download/runtime footprint for larger ones (e.g. Phi-3-mini).
AI_MODEL_DTYPE=

# Per-request inference timeout in milliseconds (default: 60000)
AI_INFERENCE_TIMEOUT_MS=60000

# Whether to attempt hardware-accelerated inference; falls back to CPU with a visible
# notice if the accelerator is unavailable (default: false)
AI_USE_ACCELERATOR=false
