# Backend HTTP server port
BACKEND_PORT=4000

# Short commit hash reported by GET /api/version (default: falls back to `git rev-parse
# --short HEAD` in a working git checkout, then "unknown" if that also fails — e.g. a
# deployed copy without a .git directory or without git installed). Set this from CI/CD
# when building a deployable artifact so the reported commit reflects the actual build.
GIT_COMMIT=

# Frontend Vite dev server port
FRONTEND_DEV_PORT=5173

# AI provider mode: "local" (Transformers.js) or "mock" (deterministic, no real model).
# Defaults to "mock" during automated tests and "local" otherwise if unset.
AI_PROVIDER_MODE=local

# Hugging Face repo id of the local model to load (default: onnx-community/Qwen2.5-0.5B-Instruct)
AI_MODEL_ID=onnx-community/Qwen2.5-0.5B-Instruct

# Local filesystem cache directory for downloaded model files (default: ~/.apipilot/models)
AI_MODEL_CACHE_DIR=

# ONNX weight quantization to load (fp32, fp16, q8, int8, uint8, q4, q4f16, bnb4).
# LEAVE UNSET on CPU. Transformers.js then uses fp32, which measured ~4x FASTER than q8 on the
# reference CPU profile (8.0 vs 2.0 tokens/second) and produced correctly structured output where
# q8 did not. q8 halves the download (~0.5GB vs ~1.7GB) but that saving is a false economy here.
# Set a quantization only for a model too large to run unquantized, and measure before trusting it
# (specs/013-ai-enhancement-viability research.md Decision 5).
AI_MODEL_DTYPE=

# Per-request inference timeout in milliseconds (default: 60000).
# Must be coherent with the output allowance: at the measured ~8 tokens/second, a 256-token
# response needs roughly 32s plus prompt-processing time. Raising this does not make a run
# viable that is not — the pre-flight check refuses impossible work up front instead.
AI_INFERENCE_TIMEOUT_MS=60000

# Conservative context window (tokens) assumed when a model reports none. Lower is safer: too low
# only costs extra batches, too high risks an opaque failure inside the model.
AI_MODEL_CONTEXT_FLOOR_TOKENS=2048

# Seed throughput estimates for the pre-flight viability check, in milliseconds per token. These
# are refined at runtime from observed inferences; they only decide whether work is attempted and
# never affect generated output.
#
# PREFILL DOMINATES. Measured on the reference CPU profile at ~42 ms per prompt token, linear in
# prompt size (43.4 / 41.3 / 42.1 ms/token at 441 / 828 / 1,132 prompt tokens, output allowance held
# at 32). A ~1,130-token prompt therefore costs ~47 seconds before the first output token exists.
# This was previously seeded at 2.0, which under-projected by 21x and would have declared every run
# viable. If you change the model or run on a GPU, re-measure this before trusting the pre-flight
# check.
AI_PREFILL_MS_PER_TOKEN=42
AI_DECODE_MS_PER_TOKEN=130

# How far a projected duration may exceed the timeout before a run is refused outright. Above 1.0
# so a marginal misestimate never blocks a run that would have succeeded.
AI_VIABILITY_SAFETY_FACTOR=1.5

# Whether to attempt hardware-accelerated inference; falls back to CPU with a visible
# notice if the accelerator is unavailable (default: false)
AI_USE_ACCELERATOR=false
